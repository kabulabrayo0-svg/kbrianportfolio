funded Marine Spatial Planning (MSP) project and the UrbanFisheries project, feeding multidisciplinary datasets on Kenya's coastal and marine environment. Committed to evidence-based research, scientific data integrity, and continuous professional development."})}),f.jsx("div",{className:"grid md:grid-cols-2 lg:grid-cols-3 gap-6",children:C5.map((e,t)=>f.jsxs(Ie.div,{initial:{opacity:0,y:20},whileInView:{opacity:1,y:0},viewport:{once:!0},transition:{duration:.5,delay:t*.08},className:"group p-6 rounded-xl border border-border hover:border-accent/30 bg-card transition-all duration-300 hover:shadow-lg hover:shadow-accent/5",children:[f.jsx("div",{className:"w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors",children:f.jsx(e.icon,{className:"w-5 h-5 text-accent"})}),f.jsx("h3",{className:"font-heading font-semibold text-sm text-foreground mb-1",children:e.label}),f.jsx("p",{className:"text-muted-foreground text-xs leading-relaxed",children:e.desc})]},e.label))})]})})}function N5({labImage:e}){return f.jsx("section",{id:"about",className:"py-24 bg-secondary/30",children:f.jsxs("div",{className:"max-w-7xl mx-auto px-6 lg:px-8",children:[f.jsx(Xt,{label:"ABOUT ME",title:"A Scientist in the Making"}),f.jsxs("div",{className:"grid lg:grid-cols-2 gap-12 items-start",children:[f.jsxs(Ie.div,{initial:{opacity:0,x:-30},whileInView:{opacity:1,x:0},viewport:{once:!0},transition:{duration:.6},className:"relative rounded-2xl overflow-hidden",children:[f.jsx("img",{src:e,alt:"Scientific laboratory equipment",className:"w-full h-80 object-cover rounded-2xl"}),f.jsx("div",{className:"absolute inset-0 bg-gradient-to-t from-[#0F172A]/60 to-transparent rounded-2xl"}),f.jsx("div",{className:"absolute bottom-4 left-4 right-4",children:f.jsx("p",{className:"font-mono text-xs text-teal-400",children:"LABORATORY · FIELD · RESEARCH"})})]}),f.jsxs(Ie.div,{initial:{opacity:0,x:30},whileInView:{opacity:1,x:0},viewport:{once:!0},tran