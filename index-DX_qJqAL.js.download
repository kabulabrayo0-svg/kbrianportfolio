inuous professional growth."})]})]})]})})}const j5=[{icon:Rc,title:"Microbiological & Water Quality Analysis",skills:["MPN dilution series","Membrane filtration","Culture techniques & isolation","Biochemical identification","Coliform & E. coli enumeration","Vibrio spp. screening","Physico-chemical water analysis","Baseline dataset generation (MSP & UrbanFisheries)"]},{icon:Tc,title:"Sediment & Environmental Sampling",skills:["Coastal sediment sampling","Water sample collection","Sample preservation & transport","Chain-of-custody handling","Nearshore gradient sampling","Field sample processing"]},{icon:Sa,title:"Laboratory Quality Systems",skills:["ISO/IEC 17025:2017-aligned practice","Good Laboratory Practice (GLP)","SOP implementation","QA/QC procedures","Biosafety practices","Traceability & documentation"]},{icon:Rx,title:"Field Survey Support",skills:["Multidisciplinary coastal surveys","Southeast Monsoon survey (Aug 2026)","North & south coast sampling","MSP & UrbanFisheries fieldwork","Team-based field operations"]},{icon:hc,title:"Data Recording & Scientific Documentation",skills:["Laboratory record management","Excel-based data analysis","Scientific reporting","Data validation","Research data management"]}];function P5({item:e,index:t}){const[n,s]=C.useState(!1);return f.jsx(Ie.div,{initial:{opacity:0,y:20},whileInView:{opacity:1,y:0},viewport:{once:!0},transition:{duration:.5,delay:t*.08},className:"group",children:f.jsxs("button",{onClick:()=>s(!n),className:"w-full text-left p-6 rounded-xl border border-border bg-card hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5 transition-all duration-300",children:[f.jsxs("div",{className:"flex items-start justify-between",children:[f.jsxs("div",{className:"flex items-start gap-4",children:[f.jsx("div",{className:"w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center shrink-0 group-hover:bg-accent/20 transition-colors",children:f.jsx(e.icon,{className:"w-5 h-5 text-accent"})}),f.jsxs("div",{c